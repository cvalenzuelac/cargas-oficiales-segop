# Copia este archivo como .env (ignorado por git). Las variables del entorno tienen prioridad.

# URL base a la que push_source.py envía (local: dev_server.py; producción: el dominio de Pages)
INGEST_URL=http://127.0.0.1:8787

# Clave compartida. En local la usan dev_server.py (como secreto) y push_source.py (como x-api-key).
# En producción debe coincidir con el secreto INGEST_KEY configurado en Cloudflare.
INGEST_KEY=cambia-esta-clave

# Clave de la API de Sara (la usa push_source.py para descargar los eventos; nunca se envía a Cloudflare)
SARA_API_KEY=

# Opcional: clave propia de una fuente (tiene prioridad sobre INGEST_KEY)
# INGEST_KEY_PLANNER=

# Opcional (solo dev_server.py): proporción máxima de tareas inválidas antes de rechazar la carga
# MAX_INVALID_RATIO=0.1
